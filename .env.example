# gem_tracker_api base URL, including the /api suffix.
# Local:      http://localhost:5000/api
VITE_API_BASE_URL=https://gem-tracker-six.vercel.app/api

# Origin of gem-tracker-app, which serves the full report view at /reports/:id.
# This must match the origin whose QR codes are printed on certificates, so a
# typed-in number and a scanned QR land on the same page.
# Local:      http://localhost:5173
VITE_REPORT_VIEW_URL=https://gemological-report-ceylon.vercel.app
